# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars — it holds plaintext secrets that Terraform
# then stores in state (see the note in ssm.tf about state-bucket encryption).

gemini_api_key = "your-gemini-api-key"
api_key        = "your-backend-x-api-key"
groq_api_key   = "your-groq-api-key"
database_url   = "" # optional — leave empty if not using Postgres persistence

# Leave empty on the first `terraform apply` (the frontend CloudFront
# distribution doesn't exist yet). After applying once, run:
#   terraform output frontend_cloudfront_domain
# and set this to "https://<that domain>", then apply again. See
# infra/README.md's two-phase-apply step.
frontend_url = ""
