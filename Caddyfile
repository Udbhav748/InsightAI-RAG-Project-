# Reverse proxy for the EC2 deployment, used only once a real domain points
# at the instance's (Elastic) IP — see docker-compose.caddy.yml and
# docs/OPERATIONS.md's "Deploying to EC2" section for the full setup.
#
# Replace both placeholder hostnames below with real subdomains before
# starting the caddy service. Caddy requests a Let's Encrypt certificate
# automatically for any address that resolves as a public DNS name; it
# skips TLS (plain HTTP) automatically for a bare IP or "localhost", so
# this file doesn't need a separate no-domain variant — it degrades on its
# own if you start it before DNS is ready, it just won't have HTTPS yet.
#
# Two hostnames, not one path-routed domain, deliberately: the frontend
# build already bakes an absolute VITE_API_BASE_URL into the JS bundle
# (see docker-compose.yml's frontend build args) and the backend already
# does CORS via Settings.frontend_url — exactly the same shape the
# Render+Vercel and Lambda+CloudFront deployments already use. Splitting
# by path instead would mean teaching the frontend to call same-origin
# relative paths in production too, which is a real change, not just
# infra config.

app.example.com {
    reverse_proxy frontend:80
}

api.example.com {
    reverse_proxy backend:8000
}
