# Copy this file to .env and fill in real values. .env is gitignored.

# Base URL of the backend API. All API calls (see src/services/api.js) read
# this via Vite's import.meta.env instead of hardcoding a URL.
VITE_API_BASE_URL=http://localhost:8000

# Sent as the X-API-Key header on every request; must match the backend's
# API_KEY (see backend/.env.example).
VITE_API_KEY=
