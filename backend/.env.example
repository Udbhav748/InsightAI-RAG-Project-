# Copy this file to .env and fill in real values. .env is gitignored.

# Required. API key for Google Gemini, used by the RAG/generation pipeline.
GEMINI_API_KEY=your_google_api_key_here

# Required. Shared secret clients must send in the X-API-Key header to reach
# the documents/query routers. Generate any long random string.
API_KEY=your_api_key_here

# Origin of the frontend app. Used to configure backend CORS.
FRONTEND_URL=http://localhost:5173

# Application name, shown in the FastAPI docs.
APP_NAME=InsightAI-RAG

# Application version, shown in the FastAPI docs.
APP_VERSION=0.1.0

# Enables debug behavior (e.g. verbose errors). true/false.
DEBUG=false

# Directory (relative to backend/) where uploaded files are stored.
UPLOAD_DIR_NAME=uploads

# Directory (relative to backend/) where chat feedback events are appended.
FEEDBACK_DIR_NAME=feedback

# Filename for the feedback JSONL file, inside FEEDBACK_DIR_NAME.
FEEDBACK_FILENAME=feedback.jsonl

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# MIME types accepted by the upload endpoint (JSON array).
ALLOWED_UPLOAD_MIME_TYPES=["application/pdf"]

# Target size of each document chunk, in characters.
CHUNK_SIZE=1000

# Character overlap between consecutive chunks.
CHUNK_OVERLAP=200

# Sentence Transformers model used to generate chunk embeddings.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Directory (relative to backend/) where the vector store is persisted.
VECTOR_STORE_DIR_NAME=vector_store

# Filename for the persisted FAISS index, inside VECTOR_STORE_DIR_NAME.
VECTOR_INDEX_FILENAME=index.faiss

# Filename for the persisted chunk metadata (JSON), inside VECTOR_STORE_DIR_NAME.
VECTOR_METADATA_FILENAME=metadata.json

# Default number of chunks to return from retrieval.
RETRIEVAL_TOP_K=5

# Default minimum similarity score a chunk must meet to be returned. Chunks
# from a genuinely relevant match typically score ~0.45-0.55 with the
# all-MiniLM-L6-v2 model; 0.3 was letting weakly-related chunks through for
# off-topic/conversational-ish queries that don't match any canned phrase in
# rag_service.py, producing technically-grounded but irrelevant answers.
RETRIEVAL_MIN_SCORE=0.4

# Minimum top-chunk similarity score for retrieval to be graded "good" (see
# ChatService._grade_retrieval). Below this (but above RETRIEVAL_MIN_SCORE),
# retrieval is graded "weak" — this is what triggers the web search fallback
# below, if enabled.
RETRIEVAL_GRADE_THRESHOLD=0.5

# Enables the web-search fallback tool (corrective RAG) for "weak"/
# "insufficient" retrieval grades. true/false. Off by default.
WEB_SEARCH_ENABLED=false

# Number of web results fetched when the fallback fires.
WEB_SEARCH_RESULT_COUNT=3

# Timeout, in seconds, for the web search call.
WEB_SEARCH_TIMEOUT_SECONDS=10

# Enables hybrid search (FAISS semantic + BM25 lexical, fused). true/false.
# Defaults on — see docs/OPERATIONS.md's "Retrieval ablation" for why
# (clean win on Precision@5/Recall@5/MRR, no real cost). Still
# config-gated so it can be A/B'd (or turned off) via the eval harness.
HYBRID_SEARCH_ENABLED=true

# Weight given to the normalized semantic score in hybrid fusion; BM25's
# weight is 1 minus this value.
HYBRID_SEMANTIC_WEIGHT=0.6

# Enables cross-encoder re-ranking of the retrieval candidate pool.
# true/false. Off by default — real Precision@5 gain but thin evidence
# (n=7) and a real per-request cost (a second model, extra inference);
# see docs/OPERATIONS.md's "Retrieval ablation" before enabling.
RERANKING_ENABLED=false

# Cross-encoder model used for re-ranking.
RERANKING_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Candidate pool size for hybrid search (per retriever) and reranking
# (before narrowing back to RETRIEVAL_TOP_K).
RETRIEVAL_CANDIDATE_K=20

# Gemini model used for text generation.
GEMINI_MODEL_NAME=gemini-3.5-flash

# Timeout, in seconds, for Gemini API calls.
GEMINI_TIMEOUT_SECONDS=30

# Which LLM provider /chat and /summarize use by default: gemini or groq.
LLM_PROVIDER=gemini

# Optional. A different provider to automatically fall back to if
# LLM_PROVIDER's own retries are exhausted. Leave blank to disable.
# Example: set LLM_PROVIDER=gemini and FALLBACK_LLM_PROVIDER=groq.
FALLBACK_LLM_PROVIDER=

# Groq API key. Required only if LLM_PROVIDER or FALLBACK_LLM_PROVIDER is groq.
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for text generation.
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Timeout, in seconds, for Groq API calls.
GROQ_TIMEOUT_SECONDS=30

# Estimated USD cost per 1,000 tokens (prompt + completion combined), used
# only to log a rough cost estimate per generation. Set to your model's
# real blended rate.
COST_PER_1K_TOKENS=0.00025

# Estimated USD cost per 1,000 tokens for Groq (usually much cheaper).
GROQ_COST_PER_1K_TOKENS=0.0006
